# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines: some env-file parsers do not strip inline comments.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------------------------------------------------------------------------
# Safety flags. DRY_RUN and BYBIT_TESTNET default to true.
# LIVE trading requires BOTH to be set to false explicitly.
# ---------------------------------------------------------------------------
# true = log what would happen, send no orders
DRY_RUN=true
# true = Bybit testnet (api-testnet.bybit.com)
BYBIT_TESTNET=true
# true = Bybit Demo Trading (api-demo.bybit.com, mainnet prices). Requires BYBIT_TESTNET=false.
BYBIT_DEMO=false

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Shared secret placed in every TradingView alert message (min 16 chars)
WEBHOOK_SECRET=
# Bearer token for /health /positions /orders /alerts /kill /resume (min 16 chars, different from WEBHOOK_SECRET)
ADMIN_TOKEN=
# Trade permission only, withdrawals DISABLED, IP-restricted to this server
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Optional Telegram notifications (set both or neither)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Deployment (used by docker-compose / Caddy)
# ---------------------------------------------------------------------------
# A DNS A record (IPv4) for this name must point at the server
DOMAIN=bot.example.com
# Let's Encrypt account email
ACME_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Webhook intake
# ---------------------------------------------------------------------------
WEBHOOK_IP_ALLOWLIST_ENABLED=true
# TradingView's published webhook IPs:
# https://www.tradingview.com/support/solutions/43000529348-about-webhooks/
WEBHOOK_IP_ALLOWLIST=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7
# TRUSTED_PROXIES is set in docker-compose.yml (Caddy's network). Leave unset without a proxy.
# Alerts that waited in the queue longer than this are rejected as stale.
MAX_ALERT_AGE_SECONDS=60

# ---------------------------------------------------------------------------
# Kill switch
# ---------------------------------------------------------------------------
# true = reject ALL new orders. POST /resume cannot override this flag.
KILL_SWITCH=false
# true = still allow close_long / close_short / close_all while the kill switch is active
KILL_SWITCH_ALLOWS_CLOSES=false

# ---------------------------------------------------------------------------
# Exchange
# ---------------------------------------------------------------------------
# one_way | hedge. Must match the position mode set on your Bybit account.
BYBIT_POSITION_MODE=one_way
# Account equity assumed in DRY_RUN when no API keys are configured
DRY_RUN_EQUITY_USD=10000
ORDER_MAX_ATTEMPTS=4

LOG_LEVEL=INFO
